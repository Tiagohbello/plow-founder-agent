#!/command/with-contenv sh
# Report this agent's usage every 5 minutes. AGENT_ID is explicit; never guess one.
# with-contenv is required for One Click Deploy: it imports PLOW_API_BASE and
# the image/runtime identity into this supervised service's environment.
PATH=/command:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
export PATH
HERMES_HOME=/var/lib/hermes
export HERMES_HOME
export AGENT_ID AGENT_NAME AGENT_BLURB

# Keep the child environment explicit. The report key is only added for the
# registration exchange; normal status/report calls use the key stored by the
# official client in the Hermes home.
client() {
  /command/s6-setuidgid hermes env -i \
    PATH="$PATH" HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" \
    AGENT_ID="$AGENT_ID" PLOW_API_BASE="$PLOW_API_BASE" ${TZ:+TZ="$TZ"} \
    "$@"
}

if [ -z "$AGENT_ID" ]; then
  echo "agent-index: no AGENT_ID in this container's environment; standing down instead of guessing" >&2
  exec sleep 86400
fi

while :; do
  client /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py status >/dev/null
  status=$?

  if [ "$status" -eq 3 ]; then
    set -- --register --agent "$AGENT_ID"
    [ -n "$AGENT_NAME" ] && set -- "$@" --name "$AGENT_NAME"
    [ -n "$AGENT_BLURB" ] && set -- "$@" --blurb "$AGENT_BLURB"
    client env "PLOW_AGENT_TOKEN=$PLOW_AGENT_TOKEN" \
      /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py \
      "$@" >/dev/null || {
      echo "agent-index: registration failed; not reporting this round" >&2
      /bin/sleep 300
      continue
      }
  elif [ "$status" -ne 0 ]; then
    echo "agent-index: status exited $status; not reporting this round" >&2
    /bin/sleep 300
    continue
  fi

  client /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py \
    || echo "agent-index: reporter exited non-zero" >&2
  /bin/sleep 300
done
