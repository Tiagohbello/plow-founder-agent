#!/bin/sh
# Report this agent's usage every 5 minutes. AGENT_ID is explicit; never guess one.
PATH=/command:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
export PATH
plow_agent_token=$(cat /run/s6/container_environment/PLOW_AGENT_TOKEN 2>/dev/null || true)
plow_token_key=PLOW_AGENT_TOKEN
# On Plow cloud the token is a placeholder and only the VM's own PLOW_API_BASE
# (an exe.dev proxy that adds the real bearer) accepts it, so registration must
# go there; without it the client falls back to the public API and 401s forever.
PLOW_API_BASE=$(cat /run/s6/container_environment/PLOW_API_BASE 2>/dev/null || true)
AGENT_ID=$(cat /run/s6/container_environment/AGENT_ID 2>/dev/null || true)
export AGENT_ID
HERMES_HOME=/var/lib/hermes
export HERMES_HOME

if [ -z "$AGENT_ID" ]; then
  echo "agent-index: no AGENT_ID; standing down instead of guessing" >&2
  exec sleep 86400
fi

while :; do
  /command/s6-setuidgid hermes \
    env HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" \
    /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py \
    status >/dev/null
  status=$?

  if [ "$status" -eq 3 ]; then
    /command/s6-setuidgid hermes \
      env HOME="$HERMES_HOME" AGENT_ID="$AGENT_ID" PLOW_API_BASE="$PLOW_API_BASE" "$plow_token_key=$plow_agent_token" \
      /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py \
      --register --agent "$AGENT_ID" >/dev/null || {
        echo "agent-index: registration failed; not reporting this round" >&2
        /bin/sleep 300
        continue
      }
  elif [ "$status" -ne 0 ]; then
    echo "agent-index: status exited $status; not reporting this round" >&2
    /bin/sleep 300
    continue
  fi

  /command/s6-setuidgid hermes \
    env HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" AGENT_ID="$AGENT_ID" PLOW_API_BASE="$PLOW_API_BASE" \
    /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py \
    || echo "agent-index: reporter exited non-zero" >&2
  /bin/sleep 300
done
