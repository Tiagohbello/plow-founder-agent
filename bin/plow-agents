#!/bin/sh
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
runner="$project_root/tools/plow-agents/bin/plow-agents"

if [ ! -x "$runner" ]; then
    echo "runner oficial ausente: execute git clone --depth 1 https://github.com/plow-pbc/plow-agents.git tools/plow-agents" >&2
    exit 1
fi

# The macOS framework Python may not expose its CA bundle to urllib. Preserve
# an explicitly configured certificate and fill it from certifi otherwise.
if [ -z "${SSL_CERT_FILE:-}" ]; then
    cert_file=$(python3 -c 'import certifi; print(certifi.where())' 2>/dev/null || true)
    if [ -n "$cert_file" ]; then
        export SSL_CERT_FILE="$cert_file"
    fi
fi

exec "$runner" "$@"
